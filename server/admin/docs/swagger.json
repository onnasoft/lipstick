{
    "schemes": [
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Administration of a Lipstick server: domains, live state, request log, visitor users and API tokens, and access rules.\n\nThe API is served over TLS. The example configuration binds it to 127.0.0.1, so only the machine itself can reach it. Reads of domains, statistics and the request log need no key, which is safe only while the port is not reachable from other machines. Every change needs the admin key.\n\nUse the Authorize button and send the admin key from admin_secret_key in server/config.yml. It is sent as it is, without a \"Bearer\" prefix.\n\nExample with curl. The certificate is self-signed, so use -k. Replace the key with admin_secret_key from server/config.yml:\n\n`curl -k -X POST 'https://127.0.0.1:5052/domains/localhost/visitor-users' -H 'Content-Type: application/json' -H 'Authorization: \u003cadmin_secret_key\u003e' -d '{\"username\": \"jtorres\"}'`\n\nWithout the Authorization header the answer is 401 Unauthorized.",
        "title": "Lipstick Admin API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "HTML panel that reads /stats, /requests and the daily traffic. Needs no key.",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Admin panel",
                "responses": {
                    "200": {
                        "description": "HTML page",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/domains": {
            "get": {
                "description": "Every domain with its policies. Client keys are never returned. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "List domains",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/admin.domainView"
                            }
                        }
                    },
                    "500": {
                        "description": "The domains could not be read. Error: 'Unable to get domains'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Registers a domain with the key its client will use. Multiple connections are allowed unless allowMultipleConnections is false. allowedCidrs is a list of networks or addresses; empty means no restriction.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Create a domain",
                "parameters": [
                    {
                        "description": "Domain to create",
                        "name": "domain",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.domainCreateBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.statusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body. The message names the field, for example 'allowedCidrs must be a list of strings' or an invalid network or address",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be saved. Error: 'Unable to add domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}": {
            "get": {
                "description": "One domain with its policies. The client key is never returned. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Get one domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.domainView"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be read. Error: 'Unable to get domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Removes the domain and disconnects its clients.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Delete a domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.statusResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be deleted. Error: 'Unable to delete domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Changes any of: apiKey, allowMultipleConnections, passthrough (not while the domain requires visitor auth), allowedCidrs (an empty list removes the rules), authLatched (only false: clearing the restricted mode). Clients of the domain are disconnected and reconnect with the new policy.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Change a domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to change; send only those",
                        "name": "changes",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.domainChangeBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.statusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body. The message names the field, for example 'allowMultipleConnections must be true or false', 'passthrough must be true or false', 'allowedCidrs must be a list of addresses or networks', or 'authLatched can only be set to false: clients set the restricted mode'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "409": {
                        "description": "Passthrough cannot be turned on for a domain that requires visitor authentication. Error: 'passthrough cannot be turned on: the domain requires visitor authentication'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be updated. Error: 'Unable to update domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/traffic": {
            "get": {
                "description": "Bytes transferred per day between two dates, inclusive. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Daily traffic of a domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "First day, YYYY-MM-DD",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Last day, YYYY-MM-DD",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.trafficResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid date. Error: 'Invalid 'from' parameter, use YYYY-MM-DD' or 'Invalid 'to' parameter, use YYYY-MM-DD'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The traffic could not be read. Error: 'Unable to get config', 'Unable to connect to database' or 'Unable to read traffic'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-tokens": {
            "get": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Tokens of a domain without their values: id, name, methods, path prefixes, creation time, and whether they are revoked.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "List API tokens",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/admin.visitorTokenItem"
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The tokens could not be listed. Error: 'unable to list tokens'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Creates a Bearer token with permissions: methods (or \"*\") and path prefixes. The token value is returned once; only its SHA-256 hash is stored. The response has no id: list the tokens to get it.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Create an API token",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Name, methods and path prefixes",
                        "name": "token",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.visitorTokenBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.visitorTokenCreated"
                        }
                    },
                    "400": {
                        "description": "Invalid body, or the token could not be created. Errors: 'token name must be 1 to 64 characters', 'a token needs at least one method, or *', or malformed JSON",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be read. Error: 'Unable to get domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-tokens/{id}": {
            "delete": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "The token stops working at once.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Revoke an API token",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Token id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.statusResponse"
                        }
                    },
                    "400": {
                        "description": "The id is not a number. Error: 'id must be a number'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain or the token does not exist. Errors: 'Domain not found' or 'visitor token not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be read. Error: 'Unable to get domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-users": {
            "get": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Usernames of a domain. Secrets are never returned.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "List visitor users",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The users could not be listed. Error: 'unable to list users'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Creates a user of a restricted domain with its own secret. Send the secret in the body (at least 32 characters) or omit it: then the server generates one and returns it in this response, the only time it is shown. The user signs each request with HMAC-SHA256 using that secret and sends it in the Authorization header as LipstickHMAC user, ts, nonce and sig. Usernames: 1 to 64 letters, digits, dots, underscores, at signs or hyphens.\nExample: curl -k -X POST 'https://127.0.0.1:5052/domains/localhost/visitor-users' -H 'Content-Type: application/json' -H 'Authorization: \u003cadmin_secret_key\u003e' -d '{\"username\": \"jtorres\"}'. Without the Authorization header the answer is 401.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Add a visitor user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Username and optional secret",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.visitorUserBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.visitorUserResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body, or the user could not be created. Errors: 'username must be 1 to 64 letters, digits, dots, underscores, at signs or hyphens', 'secret must be at least 32 characters', 'a visitor user with that name already exists', or malformed JSON",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain does not exist. Error: 'Domain not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be read. Error: 'Unable to get domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-users/{username}": {
            "delete": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Removes the user; their access ends at once.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Delete a visitor user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Username",
                        "name": "username",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.statusResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain or the user does not exist. Errors: 'Domain not found' or 'visitor user not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The domain could not be read. Error: 'Unable to get domain'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-users/{username}/rotate": {
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Replaces the secret of a user and returns the new one, shown once. The old secret stops working at once.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Rotate a visitor user's secret",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Username",
                        "name": "username",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.visitorUserResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong admin key. Error: 'Unauthorized'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "404": {
                        "description": "The domain or the user does not exist. Errors: 'Domain not found' or 'visitor user not found'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The secret could not be rotated. Error: 'unable to rotate secret'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Reports that the admin API is up. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.statusResponse"
                        }
                    }
                }
            }
        },
        "/requests": {
            "get": {
                "description": "Finished HTTP requests, newest first: domain, port the visitor came in on, method, path without query, status, duration and response size. Headers and bodies are never stored. Without from or to, the newest requests come from memory; with a time range they come from the database (kept 7 days). Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "requests"
                ],
                "summary": "Recent HTTP requests",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Only this domain",
                        "name": "domain",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Only this port: 5050 is the proxy, others are intranet ports",
                        "name": "port",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 100,
                        "description": "How many, 1 to 500",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start of the range: RFC 3339 or YYYY-MM-DD",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End of the range: RFC 3339 or YYYY-MM-DD (a date includes the whole day)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/manager.RequestRecord"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid parameter. Error: 'port must be between 1 and 65535', 'limit must be a positive number', 'from must be RFC 3339 or YYYY-MM-DD', 'to must be RFC 3339 or YYYY-MM-DD', or a range error",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    },
                    "500": {
                        "description": "The request log could not be read. Error: 'could not read the request log'",
                        "schema": {
                            "$ref": "#/definitions/admin.errorResponse"
                        }
                    }
                }
            }
        },
        "/stats": {
            "get": {
                "description": "Clients, active sessions, pending visitors, bytes since start, and intranet ports for each domain with a hub. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
