{
    "schemes": [
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Administration of a Lipstick server: domains, live state, request log, visitor users and API tokens, and access rules.\n\nThe API is served over TLS. The example configuration binds it to 127.0.0.1, so only the machine itself can reach it. Reads of domains, statistics and the request log need no key, which is safe only while the port is not reachable from other machines. Every change needs the admin key.\n\nUse the Authorize button and send the admin key from admin_secret_key in server/config.yml. It is sent as it is, without a \"Bearer\" prefix.",
        "title": "Lipstick Admin API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "HTML panel that reads /stats, /requests and the daily traffic. Needs no key.",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Admin panel",
                "responses": {
                    "200": {
                        "description": "HTML page",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/domains": {
            "get": {
                "description": "Every domain with its policies. Client keys are never returned. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "List domains",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/admin.domainView"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Registers a domain with the key its client will use. Multiple connections are allowed unless allowMultipleConnections is false. allowedCidrs is a list of networks or addresses; empty means no restriction.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Create a domain",
                "parameters": [
                    {
                        "description": "Domain: name, apiKey, allowMultipleConnections, passthrough, allowedCidrs",
                        "name": "domain",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}": {
            "get": {
                "description": "One domain with its policies. The client key is never returned. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Get one domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/admin.domainView"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Removes the domain and disconnects its clients.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Delete a domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Changes any of: apiKey, allowMultipleConnections, passthrough (not while the domain requires visitor auth), allowedCidrs (an empty list removes the rules), authLatched (only false: clearing the restricted mode). Clients of the domain are disconnected and reconnect with the new policy.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Change a domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to change",
                        "name": "changes",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "409": {
                        "description": "Passthrough would conflict with visitor auth",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/traffic": {
            "get": {
                "description": "Bytes transferred per day between two dates, inclusive. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Daily traffic of a domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "First day, YYYY-MM-DD",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Last day, YYYY-MM-DD",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-tokens": {
            "get": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Tokens of a domain without their values: id, name, methods, path prefixes, creation time, and whether they are revoked.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "List API tokens",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Creates a Bearer token with permissions: methods (or \"*\") and path prefixes. The token value is returned once; only its SHA-256 hash is stored.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Create an API token",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Name, methods, pathPrefixes",
                        "name": "token",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.visitorTokenBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "token shown once",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-tokens/{id}": {
            "delete": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "The token stops working at once.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Revoke an API token",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Token id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-users": {
            "get": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Usernames of a domain. Passwords are never returned.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "List visitor users",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Creates a user of a restricted domain with a secret of its own. The response is the only time the secret is shown: store it, the user needs it to sign requests. The user signs each request with HMAC-SHA256 and sends it in the Authorization header as LipstickHMAC user, ts, nonce and sig. Usernames: 1 to 64 letters, digits, dots, underscores, at signs or hyphens.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "visitor-auth"
                ],
                "summary": "Add a visitor user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Username",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.visitorUserBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "username and secret, shown once",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-users/{username}": {
            "delete": {
                "security": [
                    {
                        "AdminKey": []
                    },
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Replaces the secret of a user and returns the new one, shown once. The old secret stops working at once.\nRemoves the user; their access ends at once.",
                "produces": [
                    "application/json",
                    "application/json"
                ],
                "tags": [
                    "visitor-auth",
                    "visitor-auth"
                ],
                "summary": "Delete a visitor user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Username",
                        "name": "username",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Username",
                        "name": "username",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/domains/{domainName}/visitor-users/{username}/rotate": {
            "post": {
                "security": [
                    {
                        "AdminKey": []
                    },
                    {
                        "AdminKey": []
                    }
                ],
                "description": "Replaces the secret of a user and returns the new one, shown once. The old secret stops working at once.\nRemoves the user; their access ends at once.",
                "produces": [
                    "application/json",
                    "application/json"
                ],
                "tags": [
                    "visitor-auth",
                    "visitor-auth"
                ],
                "summary": "Delete a visitor user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Username",
                        "name": "username",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Domain name",
                        "name": "domainName",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Username",
                        "name": "username",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Reports that the admin API is up. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/requests": {
            "get": {
                "description": "Finished HTTP requests, newest first: domain, port the visitor came in on, method, path without query, status, duration and response size. Headers and bodies are never stored. Without from or to, the newest requests come from memory; with a time range they come from the database (kept 7 days). Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "requests"
                ],
                "summary": "Recent HTTP requests",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Only this domain",
                        "name": "domain",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Only this port: 5050 is the proxy, others are intranet ports",
                        "name": "port",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 100,
                        "description": "How many, 1 to 500",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start of the range: RFC 3339 or YYYY-MM-DD",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End of the range: RFC 3339 or YYYY-MM-DD (a date includes the whole day)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/manager.RequestRecord"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad parameter, or a range with no database",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/stats": {
            "get": {
                "description": "Clients, active sessions, pending visitors, bytes since start, and intranet ports for each domain with a hub. Needs no key.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "domains"
                ],
                "summary": "Live state of every domain",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/manager.DomainStats"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "admin.domainView": {
            "type": "object",
            "properties": {
                "allowMultipleConnections": {
                    "type": "boolean"
                },
                "allowedCidrs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "authLatched": {
                    "type": "boolean"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "passthrough": {
                    "type": "boolean"
                }
            }
        },
        "admin.visitorTokenBody": {
            "type": "object",
            "properties": {
                "methods": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "pathPrefixes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "admin.visitorUserBody": {
            "type": "object",
            "properties": {
                "username": {
                    "type": "string"
                }
            }
        },
        "manager.DomainStats": {
            "type": "object",
            "properties": {
                "activeSessions": {
                    "type": "integer"
                },
                "bytesSinceStart": {
                    "type": "integer"
                },
                "clients": {
                    "type": "integer"
                },
                "domain": {
                    "type": "string"
                },
                "intranetPorts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "pendingVisitors": {
                    "type": "integer"
                },
                "status": {
                    "description": "\"active\", \"idle\" or \"unresponsive\"",
                    "type": "string"
                }
            }
        },
        "manager.RequestRecord": {
            "type": "object",
            "properties": {
                "domain": {
                    "type": "string"
                },
                "durationMs": {
                    "type": "integer"
                },
                "method": {
                    "type": "string"
                },
                "path": {
                    "type": "string"
                },
                "port": {
                    "description": "proxy port or an intranet port; 0 when unknown",
                    "type": "integer"
                },
                "responseBytes": {
                    "type": "integer"
                },
                "status": {
                    "type": "integer"
                },
                "time": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "AdminKey": {
            "description": "Admin key, sent as it is (no \"Bearer\" prefix).",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}