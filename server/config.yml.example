# Ejemplo de configuración del servidor lipstick.
#
# Copia este archivo a config.yml y cambia los valores marcados con CAMBIAR.
# Los valores que no escribas usan los valores por defecto que se muestran.
# Las rutas relativas se resuelven desde la carpeta de este archivo.
# TLS es obligatorio: el servidor no acepta conexiones en texto plano.
# Las claves desconocidas hacen que el servidor no arranque.

# Las cuentas de la admin API se crean desde la consola del servidor:
#   lipstick-server admin create -username NOMBRE
# No hace falta ninguna clave aquí.

# Visitantes: aquí entran las peticiones públicas (https://).
proxy:
  address: ":5050"

# Clientes: aquí se conecta el cliente del túnel (https://).
manager:
  address: ":5051"

# Admin API: solo para crear y editar dominios. Escucha solo en local.
admin:
  address: "127.0.0.1:5052"

# Obligatorio. Si los archivos no existen, se genera un certificado autofirmado
# en esas rutas al arrancar. Para usar tu propio certificado, pon sus rutas.
tls:
  certificate_path: "certs/server.crt"
  key_path: "certs/server.key"

# Base de datos PostgreSQL. CAMBIAR la contraseña y, si aplica, el usuario y la base.
database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "change-me"   # CAMBIAR
  database: "app_db"
  ssl_mode: "disable"     # disable, allow, prefer, require, verify-ca o verify-full

# Servidor NATS, usado para entregar los tickets a los clientes.
nats:
  url: "nats://localhost:4222"

# Opcional. Puertos TCP SIN TLS para servicios de la intranet que no pueden
# hablar TLS (impresoras, cámaras, equipos antiguos). El cliente pide un puerto
# al conectarse, y el servidor lo abre solo si la política lo permite:
#   - bind_address: una interfaz de la intranet. 0.0.0.0 y :: se rechazan.
#   - port_range: los puertos que los clientes pueden pedir.
#   - domains: quién puede pedir puerto y desde qué redes se puede conectar.
# El puerto no tiene TLS, pero el túnel hacia el cliente sigue siendo TLS.
# intranet_ports:
#   bind_address: "10.0.0.10"
#   port_range: [5100, 5199]
#   domains:
#     - name: "robot-42.example.com"
#       allowed_cidrs:
#         - "10.20.0.0/16"

# Límites de visitantes y de la admin API. 0 desactiva un límite. Tasas por segundo.
# Las tasas cuentan conexiones nuevas, no peticiones dentro de una conexión abierta.
# Formato de los logs: text (para la terminal, por defecto) o json (un objeto por línea,
# para un colector de logs).
logging:
  format: text

limits:
  visitor_ip_rate: 50           # conexiones nuevas por segundo desde una IP
  visitor_ip_burst: 100         # ráfaga permitida por IP
  domain_rate: 500              # conexiones nuevas por segundo hacia un dominio
  domain_burst: 1000
  connections_per_ip: 512       # conexiones abiertas a la vez desde una IP
  connections_per_domain: 4096  # conexiones abiertas a la vez hacia un dominio
  admin_ip_rate: 20             # peticiones por segundo a la admin API desde una IP
  admin_ip_burst: 60
  domain_bandwidth_bytes_per_second: 0   # ancho de banda por dominio cuando no tiene el suyo; 0 = sin límite
  domain_monthly_quota_bytes: 0         # cuota mensual por dominio cuando no tiene la suya; 0 = sin límite
